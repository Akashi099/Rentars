{
  "name": "Rentars — Decentralized P2P Rentals",
  "short_name": "Rentars",
  "description": "Peer-to-peer rental platform built on the Stellar blockchain. Minimal fees, instant payments.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#2563eb",
  "orientation": "portrait-primary",
  "categories": ["travel", "lifestyle"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Search Properties",
      "short_name": "Search",
      "description": "Find properties near you",
      "url": "/search",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "List a Property",
      "short_name": "List",
      "description": "List your property on Rentars",
      "url": "/list",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "screenshots": [],
  "related_applications": [],
  "prefer_related_applications": false,
  "cache_policy": {
    "description": "Public cache policy for the Rentars PWA. Only the entry points listed below are eligible for persistent offline caching. Authenticated routes (dashboards, bookings, profile, account settings) and all authenticated API responses are network-only and must never be stored in persistent caches. User-specific caches are cleared on logout or account switch.",
    "public_cacheable": [
      "/",
      "/search",
      "/list",
      "/offline",
      "/manifest.json",
      "/icons/icon-192.png",
      "/icons/icon-192-maskable.png",
      "/icons/icon-512.png",
      "/icons/icon-512-maskable.png"
    ],
    "network_only": [
      "/dashboard",
      "/bookings",
      "/profile",
      "/account",
      "/settings",
      "/api/*"
    ]
  }
}